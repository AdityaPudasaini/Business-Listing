// schema.prisma — your database schema. The User model below is already wired to the Auth module. Add your 3 project-specific models under the marker at the bottom.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime  @default(now())
}


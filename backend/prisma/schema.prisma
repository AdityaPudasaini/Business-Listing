// schema.prisma — your database schema. The User model below is already wired to the Auth module. Add your 3 project-specific models under the marker at the bottom.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("user")
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime   @default(now())
  Business     Business[]
  Review       Review[]
  Booking      Booking[]
}

model Business {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  location    String
  latitude    Float?
  longitude   Float?
  description String?
  image       String?
  phone       String?
  whatsapp    String?
  rating      Float     @default(0)
  status      String    @default("pending")
  reviews     Review[]
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Booking {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  time       String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

// schema.prisma — your database schema. The User model below is already wired to the Auth module. Add your 3 project-specific models under the marker at the bottom.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           String          @default("user")
  phone          String?
  isBanned       Boolean         @default(false)
  resetToken     String?
  resetExpires   DateTime?
  createdAt      DateTime        @default(now())
  Business       Business[]
  Review         Review[]
  Booking        Booking[]
  socialAccounts SocialAccount[]
  chatSessions   ChatSession[]
}

model Business {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String    @unique
  category    String
  location    String
  latitude    Float?
  longitude   Float?
  description String?
  image          String?
  coverImage     String?
  gallery        String[]  @default([])
  hours          Json?
  amenities      String[]  @default([])
  paymentMethods String[]  @default([])
  services       String[]  @default([])
  website        String?
  facebook       String?
  instagram      String?
  tiktok         String?
  linkedin       String?
  parkingAvailable Boolean?
  email          String?
  phone       String?
  whatsapp    String?
  isPartner   Boolean   @default(false)
  rating      Float     @default(0)
  status      String    @default("pending")
  reviews     Review[]
  bookings    Booking[]
  products    Product[]
  announcements Announcement[]
  chatSessions ChatSession[]
  createdAt   DateTime  @default(now())
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  title      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
}

model Booking {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  time       String
  service       String?
  details       Json?
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float?
  image       String?
  category    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SocialAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

// Messages submitted through the public contact form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// One bulk email an owner (or admin, on the owner's behalf) sent to a
// business's customers. Kept for send history / audit — the actual emails
// go out via MailService and aren't stored here individually.
model Announcement {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  senderId       String
  subject        String
  message        String
  recipientCount Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([businessId])
}

// A site-wide email sent to every (non-banned) user, not scoped to one
// business. Admin-only — see BroadcastsService.
model Broadcast {
  id             String   @id @default(cuid())
  senderId       String
  subject        String
  message        String
  recipientCount Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())
}

model ChatSession {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorName String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  from      String      // "user" | "bot"
  text      String
  createdAt DateTime    @default(now())
}

// Admin-managed category tree. `category` on Business/Product stays a plain
// string column with no FK (unchanged) — this table just backs the admin UI
// and the picker/filter lists once backendSupports.categories is live. It's
// not linked to Business/Product at the DB level, so deleting a row here
// can't cascade to them; the service blocks the delete instead, checking
// every listing already filed under it. Only two levels deep (parentId's own
// parentId must be null) to match the frontend's Category/SubCategory shape.
model Category {
  id        String     @id
  label     String
  icon      String?
  order     Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryChildren")
  createdAt DateTime   @default(now())

  @@index([parentId])
}
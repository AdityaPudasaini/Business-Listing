DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=3001
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-password
# URLs — FRONTEND_URL is where the browser is sent after Google/Facebook login
# and where password-reset links point; BACKEND_URL is used to build the OAuth
# redirect URIs (<BACKEND_URL>/auth/google/callback, .../auth/facebook/callback).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Social login (optional). If a provider's pair is blank, its button redirects
# back to the frontend with a "provider_not_configured" message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VERTICAL=auto
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Change these only if your backend uses different route names.
NEXT_PUBLIC_API_CATEGORIES_PATH=/categories
NEXT_PUBLIC_API_BUSINESSES_PATH=/businesses
NEXT_PUBLIC_API_SERVICE_CATEGORIES_PATH=/service-categories
NEXT_PUBLIC_API_BOOKINGS_PATH=/bookings
NEXT_PUBLIC_API_UPLOADS_PATH=/uploads
# NEXT_IMAGE_ALLOW_LOCAL_IP=true

# Your real Google Maps key goes here (keep it only in this file, never in Git).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- New and optional ---
# Analytics: leave empty to keep it off. ga4 needs the measurement ID, plausible needs the domain.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Content-Security-Policy: off by default in development. Uncomment to try it locally.
# CSP_MODE=report-only
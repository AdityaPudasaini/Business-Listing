# Copy this file to .env.local. Restart `npm run dev` after changing it.
# Leave API_URL blank to use the bundled demo data.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_VERTICAL= 

# The site's public URL — used for canonical links, the OG image, robots.txt
# and sitemap.xml. Set this to the real production domain before deploying.
NEXT_PUBLIC_SITE_URL=

# Browser-safe/public key only. Keep private keys on the backend.
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_API_KEY_HEADER=X-API-Key
# Optional: use Bearer if the API expects Authorization: Bearer <key>.
NEXT_PUBLIC_API_AUTH_SCHEME=

# Change these only if your backend uses different route names.
NEXT_PUBLIC_API_CATEGORIES_PATH=/categories
NEXT_PUBLIC_API_BUSINESSES_PATH=/businesses
NEXT_PUBLIC_API_SERVICE_CATEGORIES_PATH=/service-categories
NEXT_PUBLIC_API_BOOKINGS_PATH=/bookings
NEXT_PUBLIC_API_UPLOADS_PATH=/uploads

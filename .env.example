# Settings for the production stack in docker-compose.yml.
# Copy this file to ".env" ON THE SERVER and fill it in. Never commit ".env".
# (Local development uses backend/.env and frontend/.env.local instead.)

# --- Images (automatic deployments, see docs/CICD.md) -------------------------
# Where the CI/CD pipeline publishes the built images:  ghcr.io/<github-name-in-lowercase>/autohub
# Leave IMAGE_PREFIX unset to build the images on this server instead.
# IMAGE_TAG is written by the deploy script; do not edit it by hand.
# IMAGE_PREFIX=ghcr.io/your-github-name/autohub

# --- Domains (DNS must already point at the server) -------------------------
# Two names under ONE parent domain, so the login cookie works between them.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Where certificate expiry notices go.
ACME_EMAIL=you@example.com

# --- Secrets: generate each with  openssl rand -hex 32 ----------------------
# Letters and digits only for the database password (it is placed inside a URL).
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Accounts ---------------------------------------------------------------
# true = new accounts must confirm their email before logging in (needs SMTP below).
REQUIRE_EMAIL_VERIFICATION=true

# --- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AutoHub Nepal <no-reply@example.com>"
CONTACT_INBOX_EMAIL=

# --- Website (baked in at build time: change, then `docker compose up -d --build`) ---
NEXT_PUBLIC_VERTICAL=auto
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# ga4 | plausible | (empty for none). Loaded only after a visitor accepts cookies.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# report-only first, then enforce once the browser console shows no violations.
CSP_MODE=report-only

# --- Social login (optional) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Chat assistant (optional) -------------------------------------------------
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

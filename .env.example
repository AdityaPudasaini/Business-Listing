# AutoHub -- production settings read by docker-compose.yml.
#
# install.sh creates .env from this file and fills in the first block for you. To set things up
# by hand instead:  cp .env.example .env   and fill in every line marked REQUIRED.
# Never commit or share .env: it holds your secrets.
#
# Changing a value later: edit .env, then run   docker compose up -d
# Exception: anything starting with NEXT_PUBLIC_ (and CSP_MODE) is baked into the website when it
# is built, so after changing one run   docker compose up -d --build frontend

# ---------------------------------------------------------------- REQUIRED (install.sh fills these)
# Two names under ONE parent domain, both pointing at this server (DNS A records).
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Used by Caddy for certificate expiry notices.
ACME_EMAIL=you@example.com
# Letters and digits only (it is placed inside a connection URL). Never change it after the first start.
POSTGRES_PASSWORD=
# At least 32 characters. Changing it signs everyone out.
JWT_SECRET=
# One-time code for the web installer at https://APP_DOMAIN/install (16+ characters).
# It stops working once the first admin exists, and you may then delete the value.
SETUP_CODE=

# ---------------------------------------------------------------- Email (run: sudo bash setup-smtp.sh)
# Needed for password reset, email confirmation and announcements.
# With REQUIRE_EMAIL_VERIFICATION=true, new accounts must confirm their email before logging in,
# so keep SMTP working or nobody can sign up. (The admin created by the web installer is exempt.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_INBOX_EMAIL=
REQUIRE_EMAIL_VERIFICATION=true

# ---------------------------------------------------------------- Optional: social login
# Redirect addresses to register with each provider:
#   https://API_DOMAIN/auth/google/callback      https://API_DOMAIN/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------- Optional: AI chat assistant
# AI_PROVIDER: none (default), openai, anthropic or groq. Fill in the matching key.
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------- Website build settings (rebuild to apply)
# auto = auto services directory.
NEXT_PUBLIC_VERTICAL=auto
# Your own Google Maps key, restricted to your site address (HTTP referrer) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Analytics (all optional): ga4 (needs the measurement ID), plausible (needs the domain), or blank for none.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# report-only logs what the security policy would block; enforce blocks it. See docs/DEPLOYMENT.md.
CSP_MODE=report-only

# IMAGE_PREFIX and IMAGE_TAG are used only by the CI/CD pipeline (docs/CICD.md). Leave them unset.
